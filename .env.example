# Your own keys. Easiest: enter them on the app's "API keys" page, which writes this file as .env.
# By hand: copy this file to .env (git ignores .env) and fill in what you use.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# MetaTrader 5 (all optional: without them the terminal's current login is used)
# MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_SERVER_UTC_OFFSET_HOURS=2
